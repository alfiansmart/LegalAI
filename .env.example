# --- LLM provider ----------------------------------------------------------
# Pick one of: anthropic | openai | azure | openrouter | ollama
LLM_PROVIDER=anthropic

# Anthropic (default — used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_DEFAULT=claude-opus-4-7
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# OpenAI (used when LLM_PROVIDER=openai) — vanilla api.openai.com
OPENAI_API_KEY=sk-...
OPENAI_MODEL_DEFAULT=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
# Optional: override the base URL only when proxying / mirroring
OPENAI_BASE_URL=
# Optional: required if your key belongs to multiple orgs
OPENAI_ORGANIZATION=

# Azure OpenAI (used when LLM_PROVIDER=azure)
# `*_DEPLOYMENT_*` values are the *deployment names* you configured in
# the Azure portal, not the underlying model names.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_DEFAULT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-4o-mini

# OpenRouter (used when LLM_PROVIDER=openrouter)
# Model strings follow OpenRouter's "<vendor>/<slug>" convention.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_DEFAULT=anthropic/claude-3.5-sonnet
OPENROUTER_MODEL_FAST=anthropic/claude-3.5-haiku
OPENROUTER_REFERER=https://github.com/alfiansmart/legalai
OPENROUTER_TITLE=LegalAI Indonesian Legal Workspace

# Ollama (used when LLM_PROVIDER=ollama) — local LLM via Ollama's
# OpenAI-compatible endpoint. No real API key required.
# Pick a model that supports OpenAI tool-calling (qwen2.5, llama3.1).
# Note: the agent's tool-use loop expects the model to honour the
# `tools` parameter — older / smaller Ollama models may not. Stick to
# the task buttons (which call skills directly) on those models.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL_DEFAULT=qwen2.5:14b
OLLAMA_MODEL_FAST=qwen2.5:3b

# --- Database --------------------------------------------------------------
POSTGRES_USER=legalai
POSTGRES_PASSWORD=legalai
POSTGRES_DB=legalai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://legalai:legalai@postgres:5432/legalai

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Embeddings ------------------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024

# --- App -------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET=change-me

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Object storage (S3-compatible, optional) ------------------------------
S3_ENDPOINT=
S3_BUCKET=legalai
S3_ACCESS_KEY=
S3_SECRET_KEY=
